# ── Server ──────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────
# Local:
MONGODB_URI=mongodb://localhost:27017/arumachwanz
# Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/arumachwanz

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=ganti_dengan_string_random_panjang_dan_aman
JWT_EXPIRES_IN=24h

# Password admin buat login ke dashboard
ADMIN_PASSWORD=admin_password_kamu

# ── CORS ─────────────────────────────────────────────
# URL frontend (dev)
CLIENT_URL=http://localhost:3000
